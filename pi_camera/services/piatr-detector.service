[Unit]
Description=PiATR camera detector
After=network-online.target piatr-mediamtx.service
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi
ExecStart=/home/pi/vision-env/bin/python /home/pi/detector.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
